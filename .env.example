# ========================================
# Devil's Advocate — Environment Variables
# ========================================

# ── OpenClaw Gateway (REQUIRED) ────────────────────────
# All LLM calls are routed through the local OpenClaw runtime.
# Install: npm install -g openclaw@latest && openclaw onboard --install-daemon
# Configure your LLM provider (Groq, OpenAI, etc.) inside OpenClaw:
#   openclaw config patch --stdin <<< '{"models":{"providers":{"groq":{"baseUrl":"...","apiKey":"...","models":[...]}}}}'
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_TOKEN=your_openclaw_token_here
OPENCLAW_MODEL=openclaw/main

# Powering the global search vision (REQUIRED for sources)
# Get your key at: https://serpapi.com
SERPAPI_API_KEY=your_serpapi_key_here

# Optional: Vector memory for persistent research sessions
# Get your key at: https://www.pinecone.io
PINECONE_API_KEY=

# Server configuration
HOST=0.0.0.0
PORT=8000
